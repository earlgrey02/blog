+// Backport from shikijs/shiki@02f05820c11859aa9ef2fa77cdfa774589ce2d1d
+export function transformerRenderLineNumber(options = {}) {
+    const { classLineNumber = 'line-number', start = 1 } = options;
+    return {
+        name: '@shikijs/transformers:render-line-number',
+        line (node, line) {
+            if (node.tagName === 'span') {
+                const num = start + line - 1;
+                node.children.unshift({
+                    type: 'element',
+                    tagName: 'span',
+                    properties: {
+                        class: classLineNumber
+                    },
+                    children: [
+                        {
+                            type: 'text',
+                            value: String(num)
+                        }
+                    ]
+                });
+            }
+        }
+    };
+}
