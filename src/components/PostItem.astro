---
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'post'>
  view: 'card' | 'wide'
}

const { post, view } = Astro.props
const { title, description, date, tags } = post.data
---

<article data-post data-tags={JSON.stringify(tags)}>
  <a
    href={`/posts/${post.id}`}
    class={view == 'card'
      ? 'flex min-h-48 min-w-0 flex-col rounded-lg border border-border bg-surface p-5 hover:border-accent md:min-h-56 md:p-6'
      : 'group block py-5 md:py-7'}>
    <div
      class={view == 'card'
        ? 'mb-5 flex items-start justify-between gap-3 text-[0.7rem] font-medium text-subtle md:mb-6 md:gap-4 md:text-xs'
        : 'mb-3 flex flex-col gap-2.5 sm:flex-row sm:items-center md:mb-4 md:gap-3'}>
      <time
        class={view == 'card' ? 'order-2 shrink-0' : 'text-xs font-medium text-subtle md:text-sm'}
        datetime={date.toISOString()}>
        {date.toISOString().slice(0, 10)}
      </time>
      <div
        class={view == 'card'
          ? 'flex flex-wrap gap-1.5 md:gap-2'
          : 'flex flex-wrap gap-1.5 text-[0.7rem] font-medium md:gap-2 md:text-xs'}>
        {(view == 'card' ? tags.slice(0, 2) : tags).map(tag => <span class="post-tag">{tag}</span>)}
      </div>
    </div>
    <h2
      class={view == 'card'
        ? 'text-lg leading-6 font-semibold tracking-tight md:text-xl md:leading-7'
        : 'text-xl leading-7 font-semibold tracking-tight transition-colors duration-300 group-hover:text-accent md:text-2xl md:leading-8'}>
      {title}
    </h2>
    <p
      class={view == 'card'
        ? 'mt-3 flex-1 text-[0.85rem] leading-6 text-muted md:mt-4 md:text-sm'
        : 'mt-2.5 max-w-2xl text-[0.85rem] leading-6 text-muted md:mt-3 md:text-sm'}>
      {description}
    </p>
  </a>
</article>
