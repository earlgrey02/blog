---
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'post'>
}

const { post } = Astro.props
const { title, description, date, tags } = post.data
---

<article>
  <a
    href={`/posts/${post.id}`}
    class="flex min-h-48 min-w-0 flex-col rounded-lg border border-border bg-surface p-5 transition hover:border-accent md:min-h-56 md:p-6">
    <div
      class="mb-5 flex items-start justify-between gap-3 text-[0.7rem] font-medium text-subtle md:mb-6 md:gap-4 md:text-xs">
      <div class="flex flex-wrap gap-1.5 md:gap-2">
        {tags.slice(0, 2).map(tag => <span class="post-tag">{tag}</span>)}
      </div>
      <time class="shrink-0" datetime={date.toISOString()}>{date.toISOString().slice(0, 10)}</time>
    </div>
    <h3 class="text-lg leading-6 font-semibold tracking-tight md:text-xl md:leading-7">{title}</h3>
    <p class="mt-3 flex-1 text-[0.85rem] leading-6 text-muted md:mt-4 md:text-sm">{description}</p>
  </a>
</article>
